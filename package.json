{
  "name": "prometheus",
  "version": "0.2.1",
  "description": "Local-first project management: Linear-style issues and cycles, Monday-style boards and timelines",
  "author": "Olympus Studios",
  "private": true,
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "test": "npm run test:unit && npm run test:sync",
    "test:unit": "node scripts/test-unit.mjs",
    "test:sync": "node scripts/test-sync.mjs"
  },
  "build": {
    "appId": "com.olympusstudios.prometheus",
    "productName": "Prometheus",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "identity": null
    },
    "afterPack": "scripts/adhoc-sign.mjs",
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "publish": null
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.21.5": true,
    "fsevents@2.3.3": true
  },
  "dependencies": {
    "sql.js": "^1.11.0"
  }
}
